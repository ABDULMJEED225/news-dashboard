# Reddit (optional — public JSON endpoints are used by default, no auth needed).
# If you hit rate limits, register a free app at https://www.reddit.com/prefs/apps
# and fill these in; fetch_reddit.py will use OAuth automatically when present.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Telegram notifications (optional — reuses the same bot as content-agent if you want)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
